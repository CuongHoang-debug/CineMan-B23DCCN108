' ===== 06_communication_banve_108.puml =====
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false

actor "Nhân viên / Khách hàng" as Actor
boundary "GDChinhNVBH108" as GDChinh
boundary "GDChonPhim108" as GDPhim
boundary "GDChonSuatChieu108" as GDLich
boundary "GDChonGhe108" as GDGhe
boundary "GDThanhToan108" as GDTT

entity "Phim108" as EPhim
entity "Suatchieu108" as ELich
entity "Ghe108" as EGhe
entity "Hoadon108" as EHD

Actor -> GDChinh : 1: Click bán vé
GDChinh -> GDPhim : 2: Gọi
GDPhim -> EPhim : 3: Gọi getphim()
EPhim -> GDPhim : 4: Trả về DS phim
GDPhim -> Actor : 5: Hiển thị
Actor -> GDPhim : 6: Click chọn phim

GDPhim -> GDLich : 7: Gọi
GDLich -> ELich : 8: Gọi getSuatChieu()
ELich -> GDLich : 9: Trả về DS suất chiếu
GDLich -> Actor : 10: Hiển thị
Actor -> GDLich : 11: Click chọn suất chiếu

GDLich -> GDGhe : 12: Gọi
GDGhe -> EGhe : 13: Gọi getghetrong()
EGhe -> GDGhe : 14: Trả về sơ đồ ghế
GDGhe -> Actor : 15: Hiển thị
Actor -> GDGhe : 16: Click chọn ghế

GDGhe -> GDTT : 17: Gọi
GDTT -> EHD : 18: Gọi getTTHoaDon()
EHD -> GDTT : 19: Trả về thông tin
GDTT -> Actor : 20: Hiển thị
Actor -> GDTT : 21: Nhập thẻ & Click thanh toán
GDTT -> EHD : 22: ThanhToan(), luuHoaDon()
EHD -> GDTT : 23: Trả về kết quả
GDTT -> Actor : 24: Thông báo thành công & in vé
@enduml

' ===== 07_sequence_analysis_banve_108.puml =====
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Nhân viên / Khách" as Actor
boundary "GDChinhNVBH108" as GD0
boundary "GDChonPhim108" as GD1
entity "Phim108" as E1
boundary "GDChonSuatChieu108" as GD2
entity "Suatchieu108" as E2
boundary "GDChonGhe108" as GD3
entity "Ghe108" as E3
boundary "GDThanhToan108" as GD4
entity "Hoadon108" as E4

Actor -> GD0 : 1: Click bán vé
activate GD0
GD0 -> GD1 : 2: Gọi
activate GD1
GD1 -> E1 : 3: Gọi
activate E1
E1 -> E1 : 4: getphim()
E1 --> GD1 : 5: Trả về
deactivate E1
GD1 --> Actor : 6: Hiển thị
Actor -> GD1 : 7: Click chọn

GD1 -> GD2 : 8: Gọi
activate GD2
GD2 -> E2 : 9: Gọi
activate E2
E2 -> E2 : 10: getSuatChieu()
E2 --> GD2 : 11: Trả về
deactivate E2
GD2 --> Actor : 12: Hiển thị
Actor -> GD2 : 13: Click chọn

GD2 -> GD3 : 14: Gọi
activate GD3
GD3 -> E3 : 15: Gọi
activate E3
E3 -> E3 : 16: getghetrong()
E3 --> GD3 : 17: Trả về
deactivate E3
GD3 --> Actor : 18: Hiển thị
Actor -> GD3 : 19: Click chọn

GD3 -> GD4 : 20: Gọi
activate GD4
GD4 -> E4 : 21: Gọi
activate E4
E4 -> E4 : 22: getTTHoaDon()
E4 --> GD4 : 23: Trả về
deactivate E4
GD4 --> Actor : 24: Hiển thị
Actor -> GD4 : 25: Click thanh toán
GD4 -> E4 : 26: Gọi
activate E4
E4 -> E4 : 27: ThanhToan(), luuHoaDon()
E4 --> GD4 : 28: Trả về
deactivate E4
GD4 --> Actor : 29: Thông báo thành công
deactivate GD4
deactivate GD3
deactivate GD2
deactivate GD1
deactivate GD0
@enduml

