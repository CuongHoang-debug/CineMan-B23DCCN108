/' -----------------------------------------------------------------
   FILE: 04_analysis_class_diagram.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B7A78
    ArrowColor #17252A
}

title BIỂU ĐỒ LỚP PHÂN TÍCH (ANALYSIS CLASS DIAGRAM) - HỆ THỐNG CINEMAN

package "Lớp Biên (Boundary Classes)" {
    class FormDangNhap <<boundary>> {
        + hienThi()
        + nhanThongTinDangNhap()
        + hienThiThongBao()
    }
    class FormDangKyThanhVien <<boundary>> {
        + hienThiForm()
        + nhanThongTinDangKy()
        + hienThiThanhCong()
        + hienThiLoi()
    }
    class FormBanVeTaiQuay <<boundary>> {
        + hienThi()
        + nhapTenPhim()
        + hienThiDSPhim()
        + hienThiSuatChieu()
        + hienThiSoDoGhe()
        + nhapMaTheThanhVien()
        + xacNhanThanhToan()
        + inVeVaHoaDon()
    }
    class FormQuanLyPhim <<boundary>> {
        + hienThiDSPhim()
        + formThemPhim()
        + formSuaPhim()
        + xacNhanXoaPhim()
    }
    class FormQuanLyPhongChieu <<boundary>> {
        + hienThiDSPhong()
        + formThemPhong()
        + formSuaPhong()
    }
    class FormLichChieu <<boundary>> {
        + hienThiDSLichChieu()
        + formTaoLichChieu()
    }
    class FormThongKe <<boundary>> {
        + chonKhoangThoiGian()
        + hienThiBaoCaoDoanhThu()
        + hienThiBaoCaoPhim()
        + hienThiBaoCaoKhachHang()
    }
}

package "Lớp Điều Khiển (Control Classes)" {
    class DangNhapCtrl <<control>> {
        + xacThucNguoiDung()
    }
    class DangKyCtrl <<control>> {
        + kiemTraThongTin()
        + xuLyDangKy()
    }
    class BanVeCtrl <<control>> {
        + timPhim()
        + laySuatChieu()
        + laySoDoGhe()
        + kiemTraThe()
        + tinhTien()
        + xuLyThanhToan()
    }
    class PhimCtrl <<control>> {
        + themPhim()
        + suaPhim()
        + xoaPhim()
    }
    class PhongChieuCtrl <<control>> {
        + themPhong()
        + suaPhong()
    }
    class LichChieuCtrl <<control>> {
        + taolichChieu()
        + kiemTraTrungGio()
    }
    class ThongKeCtrl <<control>> {
        + thongKeDoanhThu()
        + thongKePhim()
        + thongKeKhachHang()
    }
}

package "Lớp Thực Thể (Entity Classes)" {
    abstract class NguoiDung <<entity>> {
        # maND: String
        # hoTen: String
        # sdt: String
        # email: String
        # matKhau: String
    }

    class NhanVien <<entity>> {
        - maNV: String
        - chucVu: String
        - caLamViec: String
    }

    class KhachHang <<entity>> {
        - maKH: String
        - cccd: String
        - ngaySinh: Date
        - diaChi: String
    }

    class TheThanhVien <<entity>> {
        - maThe: String
        - ngayCap: Date
        - hangThe: String
        - diemTichLuy: int
        - trangThai: String
    }

    class Phim <<entity>> {
        - maPhim: String
        - tenPhim: String
        - theLoai: String
        - thoiLuong: int
        - daoDien: String
        - doTuoi: String
        - poster: String
        - trangThai: String
    }

    class PhongChieu <<entity>> {
        - maPhong: String
        - tenPhong: String
        - loaiPhong: String
        - tongSoGhe: int
    }

    class Ghe <<entity>> {
        - maGhe: String
        - soHang: String
        - soCot: int
        - loaiGhe: String
        - phuThu: float
    }

    class LichChieu <<entity>> {
        - maLichChieu: String
        - ngayChieu: Date
        - gioBatDau: Time
        - gioKetThuc: Time
        - giaVeGoc: float
    }

    class Ve <<entity>> {
        - maVe: String
        - giaBan: float
        - ngayBan: DateTime
        - trangThai: String
    }

    class HoaDon <<entity>> {
        - maHD: String
        - ngayLap: DateTime
        - tongTien: float
        - giamGia: float
        - thanhTien: float
        - phuongThucTT: String
    }
}

' Ke thua Nguoi dung
NguoiDung <|-- NhanVien
NguoiDung <|-- KhachHang

' Quan he giua cac thuc the
KhachHang "1" *-- "1" TheThanhVien : sở hữu >
PhongChieu "1" *-- "1..*" Ghe : có >
Phim "1" -- "0..*" LichChieu : được chiếu >
PhongChieu "1" -- "0..*" LichChieu : diễn ra tại >
LichChieu "1" -- "0..*" Ve : phát hành >
Ghe "1" -- "0..*" Ve : gắn với >
HoaDon "1" *-- "1..*" Ve : gồm có >
NhanVien "1" -- "0..*" HoaDon : lập >
KhachHang "0..1" -- "0..*" HoaDon : thanh toán >

' Lien ket giua Boundary va Control
FormDangKyThanhVien ..> DangKyCtrl : yêu cầu
FormBanVeTaiQuay ..> BanVeCtrl : yêu cầu
FormThongKe ..> ThongKeCtrl : yêu cầu

' Lien ket giua Control va Entity
DangKyCtrl ..> KhachHang : tạo
DangKyCtrl ..> TheThanhVien : cấp
BanVeCtrl ..> Phim : đọc
BanVeCtrl ..> LichChieu : đọc
BanVeCtrl ..> Ghe : đọc / cập nhật
BanVeCtrl ..> TheThanhVien : kiểm tra / tích điểm
BanVeCtrl ..> HoaDon : tạo
BanVeCtrl ..> Ve : tạo

@enduml



/' -----------------------------------------------------------------
   FILE: 05_sequence_analysis_dangky.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title BIỂU ĐỒ TRÌNH TỰ PHÂN TÍCH (ANALYSIS SEQUENCE DIAGRAM)\nCA SỬ DỤNG: ĐĂNG KÝ THÀNH VIÊN

actor "Khách hàng" as KH
boundary "FormDangKyThanhVien" as Form
control "DangKyCtrl" as Ctrl
entity "kh : KhachHang" as EntKH
entity "the : TheThanhVien" as EntThe

KH -> Form : chonDangKy()
activate Form

Form --> KH : hienThiFormDangKy()
KH -> Form : nhapThongTin(hoTen, sdt, email, cccd, matKhau, ngaySinh)
KH -> Form : clickDangKy()

Form -> Ctrl : xuLyDangKy(thongTinKH)
activate Ctrl

Ctrl -> Ctrl : validateThongTin(thongTinKH)

Ctrl -> EntKH : kiemTraTrungLap(sdt, email, cccd)
activate EntKH
EntKH --> Ctrl : ketQuaKiemTra(isDuplicate)
deactivate EntKH

alt [Thông tin bị trùng lặp]
    Ctrl --> Form : thongBaoLoi("Số điện thoại/Email/CCCD đã tồn tại!")
    Form --> KH : hienThiLoi()
else [Thông tin hợp lệ & Chưa tồn tại]
    Ctrl -> EntKH : taoMoiKhachHang(thongTinKH)
    activate EntKH
    EntKH --> Ctrl : khachHangMoi
    deactivate EntKH

    Ctrl -> EntThe : taoTheThanhVien(maThe, "Standard", diem=0)
    activate EntThe
    EntThe --> Ctrl : theMoi
    deactivate EntThe

    Ctrl -> EntKH : ganTheThanhVien(theMoi)

    Ctrl --> Form : thongBaoThanhCong(khachHangMoi, theMoi)
    deactivate Ctrl

    Form --> KH : hienThiThongBaoThanhCong(maThe, hoTen)
    deactivate Form
end

@enduml



/' -----------------------------------------------------------------
   FILE: 06_sequence_analysis_banve.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title BIỂU ĐỒ TRÌNH TỰ PHÂN TÍCH (ANALYSIS SEQUENCE DIAGRAM)\nCA SỬ DỤNG: BÁN VÉ TẠI QUẦY

actor "Nhân viên Bán hàng" as NV
boundary "FormBanVeTaiQuay" as Form
control "BanVeCtrl" as Ctrl
entity "Phim" as EntPhim
entity "LichChieu" as EntLich
entity "Ghe" as EntGhe
entity "TheThanhVien" as EntThe
entity "HoaDon" as EntHD
entity "Ve" as EntVe

NV -> Form : chonMenuBanVe()
activate Form
Form --> NV : hienThiManHinhBanVe()

NV -> Form : nhapTenPhim(tuKhoa)
Form -> Ctrl : timKiemPhim(tuKhoa)
activate Ctrl
Ctrl -> EntPhim : layDanhSachPhim(tuKhoa)
activate EntPhim
EntPhim --> Ctrl : dsPhim
deactivate EntPhim
Ctrl --> Form : hienThiDSPhim(dsPhim)
deactivate Ctrl

NV -> Form : chonPhim(maPhim)
Form -> Ctrl : laySuatChieu(maPhim)
activate Ctrl
Ctrl -> EntLich : laySuatChieuTheoPhim(maPhim)
activate EntLich
EntLich --> Ctrl : dsSuatChieu
deactivate EntLich
Ctrl --> Form : hienThiDSSuatChieu(dsSuatChieu)
deactivate Ctrl

NV -> Form : chonSuatChieu(maLichChieu)
Form -> Ctrl : laySoDoGhe(maLichChieu)
activate Ctrl
Ctrl -> EntGhe : layTrangThaiGhe(maLichChieu)
activate EntGhe
EntGhe --> Ctrl : dsGheVaTrangThai
deactivate EntGhe
Ctrl --> Form : hienThiSoDoGhe(dsGheVaTrangThai)
deactivate Ctrl

NV -> Form : chonCacGhe(dsMaGhe)
Form -> Form : capNhatTamTinh()

opt [Khách hàng cung cấp thẻ thành viên]
    NV -> Form : nhapMaThe(maThe)
    Form -> Ctrl : kiemTraThongTinThe(maThe)
    activate Ctrl
    Ctrl -> EntThe : timThe(maThe)
    activate EntThe
    EntThe --> Ctrl : thongTinThe
    deactivate EntThe
    Ctrl -> Ctrl : tinhChietKhau(thongTinThe, tongTienTamTinh)
    Ctrl --> Form : hienThiGiamGia(soTienGiam, tongPhaiTra)
    deactivate Ctrl
end

NV -> Form : xacNhanThanhToan(phuongThucTT, soTienNhan)
Form -> Ctrl : thucHienThanhToan(maLichChieu, dsGhe, maThe, phuongThucTT)
activate Ctrl

Ctrl -> EntHD : taoHoaDon(tongTien, giamGia, thanhTien, nv, kh)
activate EntHD
EntHD --> Ctrl : hoaDonMoi
deactivate EntHD

loop [Với mỗi ghế được chọn]
    Ctrl -> EntVe : taoVe(maLichChieu, maGhe, giaVe, hoaDonMoi)
    activate EntVe
    EntVe --> Ctrl : veMoi
    deactivate EntVe
    Ctrl -> EntGhe : capNhatTrangThaiGhe(maGhe, "ĐÃ BÁN")
end

opt [Có sử dụng thẻ thành viên]
    Ctrl -> EntThe : congDiemTichLuy(maThe, diemCong)
end

Ctrl --> Form : ketQuaGiaoDichThanhCong(hoaDonMoi, dsVe)
deactivate Ctrl

Form -> Form : goiLenhIn(hoaDon, dsVe)
Form --> NV : inXongVeVaHoaDon()
deactivate Form

@enduml


