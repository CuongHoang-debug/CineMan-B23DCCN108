----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle

title MÔ HÌNH KIẾN TRÚC PHÂN TẦNG (TIERED / MVC ARCHITECTURE)\nHỆ THỐNG CINEMAN

package "Presentation Layer (view)" {
    class DangNhapFrm
    class DangKyThanhVienFrm
    class BanVeFrm
    class ChonGheFrm
    class ThanhToanFrm
    class ThongKeFrm
}

package "Business Logic Layer (controller)" {
    class AuthController
    class KhachHangController
    class BanVeController
    class PhimController
    class ThongKeController
}

package "Data Access Layer (dao)" {
    class DBConnection
    class KhachHangDAO
    class TheThanhVienDAO
    class PhimDAO
    class LichChieuDAO
    class GheDAO
    class HoaDonDAO
    class VeDAO
    class ThongKeDAO
}

package "Domain Model Layer (model)" {
    class KhachHang
    class TheThanhVien
    class NhanVien
    class Phim
    class PhongChieu
    class Ghe
    class LichChieu
    class HoaDon
    class Ve
}

DangNhapFrm ..> AuthController
DangKyThanhVienFrm ..> KhachHangController
BanVeFrm ..> BanVeController
ThongKeFrm ..> ThongKeController

KhachHangController ..> KhachHangDAO
KhachHangController ..> TheThanhVienDAO
BanVeController ..> PhimDAO
BanVeController ..> LichChieuDAO
BanVeController ..> GheDAO
BanVeController ..> HoaDonDAO
BanVeController ..> VeDAO
ThongKeController ..> ThongKeDAO

KhachHangDAO ..> DBConnection
PhimDAO ..> DBConnection
LichChieuDAO ..> DBConnection
GheDAO ..> DBConnection
HoaDonDAO ..> DBConnection
VeDAO ..> DBConnection
ThongKeDAO ..> DBConnection

DangKyThanhVienFrm ..> KhachHang
BanVeFrm ..> HoaDon
BanVeFrm ..> Ve
BanVeController ..> HoaDon
BanVeController ..> Ve

@enduml



/' -----------------------------------------------------------------
   FILE: 08_design_class_diagram.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

title BIỂU ĐỒ LỚP THIẾT KẾ CHI TIẾT (DESIGN CLASS DIAGRAM) - HỆ THỐNG CINEMAN

package "model" {
    abstract class NguoiDung {
        - id: int
        - taiKhoan: String
        - matKhau: String
        - hoTen: String
        - sdt: String
        - email: String
        - vaiTro: String
        + NguoiDung()
        + getId(): int
        + getTaiKhoan(): String
        + getHoTen(): String
        + getSdt(): String
        + getEmail(): String
        + getVaiTro(): String
    }

    class NhanVien {
        - chucVu: String
        - caLamViec: String
        - luongCoBan: float
        + NhanVien()
        + getChucVu(): String
        + getCaLamViec(): String
    }

    class KhachHang {
        - cccd: String
        - ngaySinh: String
        - diaChi: String
        - theThanhVien: TheThanhVien
        + KhachHang()
        + getCccd(): String
        + getTheThanhVien(): TheThanhVien
        + setTheThanhVien(the: TheThanhVien): void
    }

    class TheThanhVien {
        - id: int
        - maThe: String
        - hangThe: String
        - diemTichLuy: int
        - ngayCap: String
        - trangThai: String
        + TheThanhVien()
        + getMaThe(): String
        + getHangThe(): String
        + getDiemTichLuy(): int
        + congDiem(diem: int): void
        + truDiem(diem: int): void
    }

    class Phim {
        - id: int
        - tenPhim: String
        - theLoai: String
        - thoiLuong: int
        - daoDien: String
        - doTuoi: String
        - poster: String
        - moTa: String
        - trangThai: String
        + Phim()
        + getId(): int
        + getTenPhim(): String
        + getThoiLuong(): int
        + getTrangThai(): String
    }

    class PhongChieu {
        - id: int
        - tenPhong: String
        - loaiPhong: String
        - tongSoGhe: int
        - danhSachGhe: List<Ghe>
        + PhongChieu()
        + getId(): int
        + getTenPhong(): String
        + getDanhSachGhe(): List<Ghe>
    }

    class Ghe {
        - id: int
        - maGhe: String
        - soHang: String
        - soCot: int
        - loaiGhe: String
        - phuThu: float
        + Ghe()
        + getId(): int
        + getMaGhe(): String
        + getLoaiGhe(): String
        + getPhuThu(): float
    }

    class LichChieu {
        - id: int
        - phim: Phim
        - phongChieu: PhongChieu
        - ngayChieu: String
        - gioBatDau: String
        - gioKetThuc: String
        - giaVeGoc: float
        + LichChieu()
        + getId(): int
        + getPhim(): Phim
        + getPhongChieu(): PhongChieu
        + getGiaVeGoc(): float
    }

    class Ve {
        - id: int
        - maVe: String
        - lichChieu: LichChieu
        - ghe: Ghe
        - giaBan: float
        - trangThai: String
        + Ve()
        + getId(): int
        + getGhe(): Ghe
        + getGiaBan(): float
    }

    class HoaDon {
        - id: int
        - maHD: String
        - ngayLap: String
        - nhanVien: NhanVien
        - khachHang: KhachHang
        - tongTien: float
        - giamGia: float
        - thanhTien: float
        - phuongThucTT: String
        - danhSachVe: List<Ve>
        + HoaDon()
        + themVe(ve: Ve): void
        + getThanhTien(): float
    }
}

package "dao" {
    class DBConnection {
        - {static} instance: DBConnection
        - connection: Connection
        - DBConnection()
        + {static} getInstance(): DBConnection
        + getConnection(): Connection
    }

    class KhachHangDAO {
        + themKhachHang(kh: KhachHang): boolean
        + kiemTraTrung(sdt: String, email: String, cccd: String): boolean
        + timTheoMaThe(maThe: String): KhachHang
        + layTatCaKhachHang(): List<KhachHang>
    }

    class TheThanhVienDAO {
        + themThe(the: TheThanhVien, idKH: int): boolean
        + timTheoMa(maThe: String): TheThanhVien
        + capNhatDiem(maThe: String, diemMoi: int): boolean
    }

    class PhimDAO {
        + timPhim(tuKhoa: String): List<Phim>
        + layTatCaPhim(): List<Phim>
        + themPhim(p: Phim): boolean
        + suaPhim(p: Phim): boolean
        + xoaPhim(idPhim: int): boolean
    }

    class LichChieuDAO {
        + layLichTheoPhim(idPhim: int): List<LichChieu>
        + layChiTietLich(idLich: int): LichChieu
        + themLichChieu(lc: LichChieu): boolean
    }

    class GheDAO {
        + layGheTheoPhong(idPhong: int): List<Ghe>
        + layTrangThaiGhe(idLich: int): Map<Integer, String>
    }

    class HoaDonDAO {
        + taoHoaDon(hd: HoaDon): int
        + layHoaDonTheoId(idHD: int): HoaDon
    }

    class VeDAO {
        + taoVe(ve: Ve, idHD: int): boolean
        + layVeTheoHoaDon(idHD: int): List<Ve>
    }

    class ThongKeDAO {
        + thongKeDoanhThu(tuNgay: String, denNgay: String): Map<String, Object>
        + thongKePhim(tuNgay: String, denNgay: String): List<Map<String, Object>>
        + thongKeKhachHang(): List<Map<String, Object>>
    }
}

package "controller" {
    class KhachHangController {
        - khDAO: KhachHangDAO
        - theDAO: TheThanhVienDAO
        + dangKyThanhVien(kh: KhachHang): Map<String, Object>
        + kiemTraThe(maThe: String): TheThanhVien
    }

    class BanVeController {
        - phimDAO: PhimDAO
        - lichDAO: LichChieuDAO
        - gheDAO: GheDAO
        - theDAO: TheThanhVienDAO
        - hoaDonDAO: HoaDonDAO
        - veDAO: VeDAO
        + timKiemPhim(tuKhoa: String): List<Phim>
        + chonPhim(idPhim: int): List<LichChieu>
        + chonSuatChieu(idLich: int): Map<String, Object>
        + tinhTien(idLich: int, dsIdGhe: List<Integer>, maThe: String): Map<String, Object>
        + xacNhanThanhToan(idLich: int, dsIdGhe: List<Integer>, maThe: String, pttt: String, idNV: int): HoaDon
    }

    class ThongKeController {
        - tkDAO: ThongKeDAO
        + xemDoanhThu(tuNgay: String, denNgay: String): Map<String, Object>
        + xemThongKePhim(tuNgay: String, denNgay: String): List<Map<String, Object>>
        + xemThongKeKhachHang(): List<Map<String, Object>>
    }
}

package "view" {
    class DangKyThanhVienFrm {
        - ctrlKH: KhachHangController
        + btnDangKy_Click(): void
        + hienThiThanhCong(): void
    }

    class BanVeFrm {
        - ctrlBanVe: BanVeController
        + btnTimPhim_Click(): void
        + onPhimSelected(): void
        + onSuatChieuSelected(): void
        + onGheSelected(): void
        + btnApDungThe_Click(): void
        + btnThanhToan_Click(): void
        + inVeVaHoaDon(hd: HoaDon): void
    }

    class ThongKeFrm {
        - ctrlTK: ThongKeController
        + btnXemThongKe_Click(): void
        + hienThiBaoCao(): void
    }
}

' Thua ke
NguoiDung <|-- NhanVien
NguoiDung <|-- KhachHang

' Quan he Model
KhachHang "1" *-- "1" TheThanhVien
PhongChieu "1" *-- "1..*" Ghe
Phim "1" -- "0..*" LichChieu
PhongChieu "1" -- "0..*" LichChieu
LichChieu "1" -- "0..*" Ve
Ghe "1" -- "0..*" Ve
HoaDon "1" *-- "1..*" Ve
NhanVien "1" -- "0..*" HoaDon
KhachHang "0..1" -- "0..*" HoaDon

' Quan he giua cac tang
BanVeFrm ..> BanVeController
DangKyThanhVienFrm ..> KhachHangController
ThongKeFrm ..> ThongKeController

BanVeController ..> PhimDAO
BanVeController ..> LichChieuDAO
BanVeController ..> GheDAO
BanVeController ..> TheThanhVienDAO
BanVeController ..> HoaDonDAO
BanVeController ..> VeDAO

KhachHangController ..> KhachHangDAO
KhachHangController ..> TheThanhVienDAO

ThongKeController ..> ThongKeDAO

KhachHangDAO ..> DBConnection
PhimDAO ..> DBConnection
LichChieuDAO ..> DBConnection
GheDAO ..> DBConnection
HoaDonDAO ..> DBConnection
VeDAO ..> DBConnection
ThongKeDAO ..> DBConnection

@enduml



/' -----------------------------------------------------------------
   FILE: 09_sequence_design_dangky.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title BIỂU ĐỒ TRÌNH TỰ THIẾT KẾ CHI TIẾT (DESIGN SEQUENCE DIAGRAM)\nCA SỬ DỤNG: ĐĂNG KÝ THÀNH VIÊN

actor "Khách hàng" as KH
boundary "view: DangKyThanhVienFrm" as View
control "ctrl: KhachHangController" as Ctrl
participant "khDAO: KhachHangDAO" as KHDAO
participant "theDAO: TheThanhVienDAO" as TheDAO
database "db: DBConnection" as DB
entity "kh: KhachHang" as EntKH
entity "the: TheThanhVien" as EntThe

KH -> View : nhapThongTin(hoTen, sdt, email, cccd, matKhau, ngaySinh)
KH -> View : click btnDangKy_Click()
activate View

View -> Ctrl : dangKyThanhVien(khachHangDTO)
activate Ctrl

Ctrl -> KHDAO : kiemTraTrung(sdt, email, cccd)
activate KHDAO
KHDAO -> DB : executeQuery("SELECT id FROM tblKhachHang WHERE...")
activate DB
DB --> KHDAO : ResultSet (count)
deactivate DB
KHDAO --> Ctrl : isExisted (boolean)
deactivate KHDAO

alt isExisted == true
    Ctrl --> View : return Result(status=FAIL, message="Thông tin đã tồn tại!")
    View --> KH : hienThiLoi("SĐT hoặc Email hoặc CCCD đã được đăng ký!")
else isExisted == false
    Ctrl -> EntThe ** : create(maThe="MB" + random, hangThe="Standard", diem=0)
    Ctrl -> EntKH ** : create(hoTen, sdt, email, cccd, hashPass, ngaySinh)
    
    Ctrl -> KHDAO : themKhachHang(kh)
    activate KHDAO
    KHDAO -> DB : executeUpdate("INSERT INTO tblNguoiDung...", "INSERT INTO tblKhachHang...")
    activate DB
    DB --> KHDAO : newKhachHangId
    deactivate DB
    KHDAO --> Ctrl : newKhachHangId
    deactivate KHDAO

    Ctrl -> TheDAO : themThe(the, newKhachHangId)
    activate TheDAO
    TheDAO -> DB : executeUpdate("INSERT INTO tblTheThanhVien (maThe, hangThe, idKH)...")
    activate DB
    DB --> TheDAO : rowsAffected (1)
    deactivate DB
    TheDAO --> Ctrl : true
    deactivate TheDAO

    Ctrl --> View : return Result(status=SUCCESS, maThe=the.getMaThe(), hoTen=kh.getHoTen())
    deactivate Ctrl

    View --> KH : hienThiThanhCong("Đăng ký thành viên thành công! Mã thẻ: " + maThe)
    deactivate View
end

@enduml



/' -----------------------------------------------------------------
   FILE: 10_sequence_design_banve.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title BIỂU ĐỒ TRÌNH TỰ THIẾT KẾ CHI TIẾT (DESIGN SEQUENCE DIAGRAM)\nCA SỬ DỤNG: BÁN VÉ TẠI QUẦY

actor "Nhân viên Bán hàng" as NV
boundary "view: BanVeFrm" as View
control "ctrl: BanVeController" as Ctrl
participant "phimDAO: PhimDAO" as PhimDAO
participant "lichDAO: LichChieuDAO" as LichDAO
participant "gheDAO: GheDAO" as GheDAO
participant "theDAO: TheThanhVienDAO" as TheDAO
participant "hdDAO: HoaDonDAO" as HdDAO
participant "veDAO: VeDAO" as VeDAO
database "db: DBConnection" as DB

NV -> View : nhap tuKhoa + click btnTimPhim()
activate View
View -> Ctrl : timKiemPhim(tuKhoa)
activate Ctrl
Ctrl -> PhimDAO : timPhim(tuKhoa)
activate PhimDAO
PhimDAO -> DB : executeQuery("SELECT * FROM tblPhim WHERE tenPhim LIKE...")
activate DB
DB --> PhimDAO : ResultSet
deactivate DB
PhimDAO --> Ctrl : List<Phim>
deactivate PhimDAO
Ctrl --> View : List<Phim>
deactivate Ctrl
View --> NV : hienThiDanhSachPhim()

NV -> View : onPhimSelected(idPhim)
View -> Ctrl : chonPhim(idPhim)
activate Ctrl
Ctrl -> LichDAO : layLichTheoPhim(idPhim)
activate LichDAO
LichDAO -> DB : executeQuery("SELECT * FROM tblLichChieu WHERE idPhim =...")
activate DB
DB --> LichDAO : ResultSet
deactivate DB
LichDAO --> Ctrl : List<LichChieu>
deactivate LichDAO
Ctrl --> View : List<LichChieu>
deactivate Ctrl
View --> NV : hienThiCacKhungGio()

NV -> View : onSuatChieuSelected(idLich)
View -> Ctrl : chonSuatChieu(idLich)
activate Ctrl
Ctrl -> GheDAO : layGheTheoPhong(idPhong)
activate GheDAO
GheDAO -> DB : executeQuery("SELECT * FROM tblGhe WHERE idPhong =...")
activate DB
DB --> GheDAO : List<Ghe>
deactivate DB
GheDAO --> Ctrl : List<Ghe>
deactivate GheDAO
Ctrl -> GheDAO : layTrangThaiGhe(idLich)
activate GheDAO
GheDAO -> DB : executeQuery("SELECT idGhe FROM tblVe WHERE idLichChieu =...")
activate DB
DB --> GheDAO : Set<idGheDaDat>
deactivate DB
GheDAO --> Ctrl : Map<Integer, String>
deactivate GheDAO
Ctrl --> View : Map<Ghe, TrangThai>
deactivate Ctrl
View --> NV : hienThiSoDoGhe(MaTranGhe)

NV -> View : onGheSelected(dsIdGhe)
View -> Ctrl : tinhTien(idLich, dsIdGhe, maThe=null)
activate Ctrl
Ctrl --> View : Map(tongGoc, giamGia=0, thanhTien)
deactivate Ctrl
View --> NV : hienThiTamTinh()

opt Khách hàng có Thẻ thành viên
    NV -> View : nhap maThe + click btnApDungThe()
    View -> Ctrl : tinhTien(idLich, dsIdGhe, maThe)
    activate Ctrl
    Ctrl -> TheDAO : timTheoMa(maThe)
    activate TheDAO
    TheDAO -> DB : executeQuery("SELECT * FROM tblTheThanhVien WHERE maThe =...")
    activate DB
    DB --> TheDAO : ResultSet
    deactivate DB
    TheDAO --> Ctrl : TheThanhVien
    deactivate TheDAO
    Ctrl -> Ctrl : tinhChietKhau(theThanhVien, tongGoc)
    Ctrl --> View : Map(tongGoc, giamGia, thanhTien)
    deactivate Ctrl
    View --> NV : capNhatTienSauGiamGia()
end

NV -> View : chon PTTT + click btnThanhToan()
View -> Ctrl : xacNhanThanhToan(idLich, dsIdGhe, maThe, pttt, idNV)
activate Ctrl

Ctrl -> DB : setAutoCommit(false) [Transaction Start]
activate DB
deactivate DB

Ctrl -> HdDAO : taoHoaDon(hd)
activate HdDAO
HdDAO -> DB : executeUpdate("INSERT INTO tblHoaDon...")
activate DB
DB --> HdDAO : idHoaDonMoi
deactivate DB
HdDAO --> Ctrl : idHoaDonMoi
deactivate HdDAO

loop Tung idGhe in dsIdGhe
    Ctrl -> VeDAO : taoVe(ve, idHoaDonMoi)
    activate VeDAO
    VeDAO -> DB : executeUpdate("INSERT INTO tblVe (idLich, idGhe, gia, idHD)...")
    activate DB
    DB --> VeDAO : true
    deactivate DB
    VeDAO --> Ctrl : true
    deactivate VeDAO
end

opt maThe != null
    Ctrl -> TheDAO : capNhatDiem(maThe, diemMoi)
    activate TheDAO
    TheDAO -> DB : executeUpdate("UPDATE tblTheThanhVien SET diem =...")
    activate DB
    DB --> TheDAO : true
    deactivate DB
    TheDAO --> Ctrl : true
    deactivate TheDAO
end

Ctrl -> DB : commit() [Transaction Complete]
activate DB
deactivate DB

Ctrl --> View : return HoaDonDetail(hd, dsVe)
deactivate Ctrl

View -> View : inVeVaHoaDon(HoaDonDetail)
View --> NV : inThanhCongVaXuatHoaDon()
deactivate View

@enduml



/' -----------------------------------------------------------------
   FILE: 11_erd_database.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho

title LƯỢC ĐỒ CƠ SỞ DỮ LIỆU QUAN HỆ (ERD) - HỆ THỐNG CINEMAN

entity "tblNguoiDung" as tblNguoiDung {
    * id : INT <<PK, AI>>
    --
    * taiKhoan : VARCHAR(50) <<UNIQUE>>
    * matKhau : VARCHAR(255)
    * hoTen : VARCHAR(100)
    * sdt : VARCHAR(15) <<UNIQUE>>
    * email : VARCHAR(100) <<UNIQUE>>
    * vaiTro : VARCHAR(20) -- 'QUAN_LY', 'BAN_HANG', 'KHACH_HANG'
    ngayTao : DATETIME
}

entity "tblNhanVien" as tblNhanVien {
    * id : INT <<PK, FK>>
    --
    * chucVu : VARCHAR(50)
    caLamViec : VARCHAR(50)
    luongCoBan : FLOAT
}

entity "tblKhachHang" as tblKhachHang {
    * id : INT <<PK, FK>>
    --
    * cccd : VARCHAR(20) <<UNIQUE>>
    ngaySinh : DATE
    diaChi : VARCHAR(255)
}

entity "tblTheThanhVien" as tblTheThanhVien {
    * id : INT <<PK, AI>>
    --
    * maThe : VARCHAR(30) <<UNIQUE>>
    * idKhachHang : INT <<FK, UNIQUE>>
    * hangThe : VARCHAR(20) -- 'Standard', 'Silver', 'Gold', 'VIP'
    * diemTichLuy : INT
    ngayCap : DATE
    trangThai : VARCHAR(20)
}

entity "tblPhim" as tblPhim {
    * id : INT <<PK, AI>>
    --
    * tenPhim : VARCHAR(255)
    theLoai : VARCHAR(100)
    thoiLuong : INT -- Phút
    daoDien : VARCHAR(100)
    dienVien : VARCHAR(255)
    doTuoi : VARCHAR(10) -- 'P', 'T13', 'T16', 'T18'
    poster : VARCHAR(255)
    moTa : TEXT
    trangThai : VARCHAR(20) -- 'DANG_CHIEU', 'SAP_CHIEU', 'NGUNG_CHIEU'
}

entity "tblPhongChieu" as tblPhongChieu {
    * id : INT <<PK, AI>>
    --
    * tenPhong : VARCHAR(50)
    * loaiPhong : VARCHAR(20) -- '2D', '3D', 'IMAX'
    * tongSoGhe : INT
}

entity "tblGhe" as tblGhe {
    * id : INT <<PK, AI>>
    --
    * idPhong : INT <<FK>>
    * maGhe : VARCHAR(10) -- Ví dụ: A01, B05...
    * soHang : VARCHAR(5)
    * soCot : INT
    * loaiGhe : VARCHAR(20) -- 'THUONG', 'VIP', 'DOI'
    * phuThu : FLOAT
}

entity "tblLichChieu" as tblLichChieu {
    * id : INT <<PK, AI>>
    --
    * idPhim : INT <<FK>>
    * idPhong : INT <<FK>>
    * ngayChieu : DATE
    * gioBatDau : TIME
    * gioKetThuc : TIME
    * giaVeGoc : FLOAT
}

entity "tblHoaDon" as tblHoaDon {
    * id : INT <<PK, AI>>
    --
    * maHD : VARCHAR(30) <<UNIQUE>>
    * idNhanVien : INT <<FK>>
    idKhachHang : INT <<FK>> -- Nullable nếu khách vãng lai
    * ngayLap : DATETIME
    * tongTien : FLOAT
    * giamGia : FLOAT
    * thanhTien : FLOAT
    * phuongThucTT : VARCHAR(30) -- 'TIEN_MAT', 'CHUYEN_KHOAN', 'THE'
}

entity "tblVe" as tblVe {
    * id : INT <<PK, AI>>
    --
    * maVe : VARCHAR(30) <<UNIQUE>>
    * idLichChieu : INT <<FK>>
    * idGhe : INT <<FK>>
    * idHoaDon : INT <<FK>>
    * giaBan : FLOAT
    ngayBan : DATETIME
    trangThai : VARCHAR(20) -- 'DA_BAN', 'DA_HUY'
}

' Moi quan he quan he
tblNguoiDung ||--o| tblNhanVien : 1 - 0..1 (Kế thừa)
tblNguoiDung ||--o| tblKhachHang : 1 - 0..1 (Kế thừa)
tblKhachHang ||--|| tblTheThanhVien : 1 - 1
tblPhongChieu ||--|{ tblGhe : 1 - N
tblPhim ||--o{ tblLichChieu : 1 - N
tblPhongChieu ||--o{ tblLichChieu : 1 - N
tblNhanVien ||--o{ tblHoaDon : 1 - N
tblKhachHang ||--o{ tblHoaDon : 1 - N
tblHoaDon ||--|{ tblVe : 1 - N
