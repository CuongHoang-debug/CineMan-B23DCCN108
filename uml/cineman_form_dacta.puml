/' -----------------------------------------------------------------
   FILE: 01_usecase_tongquat.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #E8F4F8
    BorderColor #2B7A78
    ArrowColor #17252A
    FontColor #17252A
}
skinparam actor {
    BackgroundColor #DEF2F1
    BorderColor #2B7A78
    FontColor #17252A
}

title SƠ ĐỒ CA SỬ DỤNG TỔNG QUÁT (USE CASE DIAGRAM) - HỆ THỐNG CINEMAN

actor "Khách hàng" as KH
actor "Nhân viên\nBán hàng" as NVBH
actor "Nhân viên\nQuản lý" as NVQL

rectangle "Hệ thống Quản lý Rạp Chiếu Phim CineMan" {
    ' Ca su dung chung
    usecase "UC00: Đăng nhập hệ thống" as UC_Login
    usecase "UC00b: Đăng xuất" as UC_Logout

    ' Ca su dung Khach hang
    package "Phân hệ Khách hàng" {
        usecase "UC01: Đăng ký thành viên" as UC_DangKy
        usecase "UC02: Tìm kiếm phim & lịch chiếu" as UC_TimPhim
        usecase "UC03: Mua vé trực tuyến" as UC_MuaVeOnline
    }

    ' Ca su dung Nhan vien Ban hang
    package "Phân hệ Bán vé & Dịch vụ" {
        usecase "UC04: Bán vé tại quầy" as UC_BanVe
        usecase "UC04.1: Tìm & Chọn phim" as UC_ChonPhim
        usecase "UC04.2: Chọn suất chiếu" as UC_ChonSuat
        usecase "UC04.3: Chọn ghế ngồi" as UC_ChonGhe
        usecase "UC04.4: Thanh toán & In vé" as UC_ThanhToan
        usecase "UC04.5: Áp dụng thẻ thành viên" as UC_ApDungThe
        usecase "UC05: Xuất thẻ thành viên tại quầy" as UC_XuatThe
    }

    ' Ca su dung Nhan vien Quan ly
    package "Phân hệ Quản lý & Thống kê" {
        usecase "UC06: Quản lý thông tin phim" as UC_QLPhim
        usecase "UC07: Quản lý phòng chiếu" as UC_QLPhong
        usecase "UC08: Lên lịch chiếu phim" as UC_LenLich
        usecase "UC09: Xem thống kê báo cáo" as UC_XemThongKe
        usecase "UC09.1: Thống kê doanh thu" as UC_TKDoanhThu
        usecase "UC09.2: Thống kê phim" as UC_TKPhim
        usecase "UC09.3: Thống kê khách hàng" as UC_TKKhachHang
    }
}

' Quan he giua Actor va Use Case
KH --> UC_Login
KH --> UC_DangKy
KH --> UC_TimPhim
KH --> UC_MuaVeOnline

NVBH --> UC_Login
NVBH --> UC_Logout
NVBH --> UC_BanVe
NVBH --> UC_XuatThe

NVQL --> UC_Login
NVQL --> UC_Logout
NVQL --> UC_QLPhim
NVQL --> UC_QLPhong
NVQL --> UC_LenLich
NVQL --> UC_XemThongKe

' Quan he include va extend trong Ban ve tai quay
UC_BanVe ..> UC_ChonPhim : <<include>>
UC_BanVe ..> UC_ChonSuat : <<include>>
UC_BanVe ..> UC_ChonGhe : <<include>>
UC_BanVe ..> UC_ThanhToan : <<include>>
UC_ApDungThe ..> UC_BanVe : <<extend>>

' Quan he include trong Thong ke
UC_XemThongKe ..> UC_TKDoanhThu : <<include>>
UC_XemThongKe ..> UC_TKPhim : <<include>>
UC_XemThongKe ..> UC_TKKhachHang : <<include>>

@enduml



/' -----------------------------------------------------------------
   FILE: 02_activity_dangky_thanhvien.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
    BackgroundColor #E8F4F8
    BorderColor #2B7A78
    FontColor #17252A
    DiamondBackgroundColor #DEF2F1
    DiamondBorderColor #2B7A78
}

title SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM) - CA SỬ DỤNG: ĐĂNG KÝ THÀNH VIÊN

|#E8F8F5|Khách hàng|
|#EBF5FB|Giao diện CineMan|
|#FEF9E7|Hệ thống (Controller & CSDL)|

|Khách hàng|
start
:Truy cập hệ thống và chọn\n"Đăng ký thành viên";

|Giao diện CineMan|
:Hiển thị Form Đăng ký thành viên\n(Họ tên, SĐT, Email, CCCD, Mật khẩu, Ngày sinh);

|Khách hàng|
:Nhập đầy đủ thông tin cá nhân;
:Nhấn nút "Đăng ký";

|Giao diện CineMan|
:Thu thập dữ liệu từ Form;
:Gửi yêu cầu đăng ký tới Hệ thống;

|Hệ thống (Controller & CSDL)|
:Kiểm tra tính hợp lệ dữ liệu\n(Format email, độ dài SĐT, mật khẩu);
if (Dữ liệu hợp lệ?) then (Không)
    |Giao diện CineMan|
    :Hiển thị thông báo lỗi nhập liệu;
    |Khách hàng|
    :Nhập lại thông tin đúng định dạng;
    detach
else (Có)
    |Hệ thống (Controller & CSDL)|
    :Truy vấn CSDL kiểm tra trùng\nlặp Số điện thoại / Email / CCCD;
    if (Đã tồn tại trong hệ thống?) then (Có trùng)
        |Giao diện CineMan|
        :Thông báo lỗi: SĐT hoặc Email\nhoặc CCCD đã được đăng ký;
        |Khách hàng|
        :Kiểm tra lại thông tin;
        detach
    else (Không trùng)
        |Hệ thống (Controller & CSDL)|
        :Mã hóa mật khẩu người dùng;
        :Khởi tạo thực thể Khách hàng mới;
        :Tự động sinh Mã thẻ thành viên (MEMBER-XXXX);\nKhởi tạo Hạng thẻ = "Standard", Điểm = 0;
        :Lưu thông tin Khách hàng và\nThẻ thành viên vào Cơ sở dữ liệu;
        
        |Giao diện CineMan|
        :Hiển thị thông báo: "Đăng ký thành công!";
        :Hiển thị thông tin Thẻ thành viên được cấp;
        
        |Khách hàng|
        :Nhận mã thẻ và hoàn tất đăng ký;
        stop
    endif
endif

@enduml



/' -----------------------------------------------------------------
   FILE: 03_activity_banve_taiquay.puml
----------------------------------------------------------------- '/
@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
    BackgroundColor #E8F4F8
    BorderColor #2B7A78
    FontColor #17252A
    DiamondBackgroundColor #DEF2F1
    DiamondBorderColor #2B7A78
}

title SƠ ĐỒ HOẠT ĐỘNG (ACTIVITY DIAGRAM) - CA SỬ DỤNG: BÁN VÉ TẠI QUẦY

|#E8F8F5|Khách hàng|
|#FEF9E7|Nhân viên Bán hàng|
|#EBF5FB|Giao diện CineMan|
|#FDEDEC|Hệ thống & CSDL|

|Nhân viên Bán hàng|
start
:Đăng nhập và chọn menu\n"Bán vé tại quầy";

|Giao diện CineMan|
:Hiển thị màn hình Bán vé\nvà ô tìm kiếm phim;

|Khách hàng|
:Yêu cầu tên phim muốn xem;

|Nhân viên Bán hàng|
:Nhập tên phim vào ô tìm kiếm;

|Giao diện CineMan|
:Gửi từ khóa tìm kiếm sang Hệ thống;

|Hệ thống & CSDL|
:Truy vấn CSDL danh sách phim\nđang có lịch chiếu phù hợp;

|Giao diện CineMan|
:Hiển thị danh sách kết quả phim;

|Nhân viên Bán hàng|
:Chọn phim khách muốn xem;

|Hệ thống & CSDL|
:Lấy danh sách các Suất chiếu\ntrong ngày của phim đã chọn;

|Giao diện CineMan|
:Hiển thị các khung giờ chiếu (Suất chiếu);

|Khách hàng|
:Chọn khung giờ xem mong muốn;

|Nhân viên Bán hàng|
:Click chọn Suất chiếu tương ứng;

|Hệ thống & CSDL|
:Tải sơ đồ phòng chiếu và trạng thái\ncác ghế (Trống / Đã đặt / VIP / Thường);

|Giao diện CineMan|
:Hiển thị sơ đồ ghế ngồi trực quan;

|Khách hàng|
:Chọn vị trí các ghế muốn ngồi;

|Nhân viên Bán hàng|
:Click chọn các vị trí ghế tương ứng;
:Hỏi khách hàng về Thẻ thành viên;

if (Khách có Thẻ thành viên?) then (Có thẻ)
    |Nhân viên Bán hàng|
    :Nhập Mã thẻ thành viên của khách;
    |Hệ thống & CSDL|
    :Kiểm tra thông tin Thẻ thành viên;\nTính toán chiết khấu giảm giá (5% - 10%);\nTính điểm tích lũy mới;
    |Giao diện CineMan|
    :Hiển thị thông tin chủ thẻ, số tiền giảm\nvà Tổng tiền sau giảm giá;
else (Không có thẻ)
    |Giao diện CineMan|
    :Hiển thị Tổng tiền theo giá gốc;
endif

|Nhân viên Bán hàng|
:Thông báo tổng số tiền cần thanh toán;

|Khách hàng|
:Thực hiện thanh toán\n(Tiền mặt / Chuyển khoản QR / Thẻ);

|Nhân viên Bán hàng|
:Chọn phương thức thanh toán\nvà nhấn nút "Xác nhận & Xuất vé";

|Hệ thống & CSDL|
:Bắt đầu giao dịch Transaction:;
:Cập nhật trạng thái ghế thành "Đã bán";
:Tạo bản ghi Hóa đơn (tblHoaDon);
:Tạo các bản ghi Vé (tblVe) tương ứng từng ghế;
if (Khách có thẻ thành viên?) then (Có)
    :Cộng điểm tích lũy vào Thẻ thành viên;
endif
:Commit giao dịch CSDL;

|Giao diện CineMan|
:Kích hoạt lệnh in Vé và Hóa đơn;

|Nhân viên Bán hàng|
:Nhận vé in và hóa đơn từ máy in;
:Trao vé và hóa đơn cho Khách hàng;

|Khách hàng|
:Nhận vé xem phim và hóa đơn;
stop

@enduml


